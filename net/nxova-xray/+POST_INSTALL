#!/bin/sh
#
# +POST_INSTALL for os-nxova-xray (minimal: file setup only, no external commands)
#
# This script intentionally avoids calling external commands like
# `service` or `pluginctl`: on some systems pkg's install child can die
# with a segmentation fault when the script forks helpers. All the
# essential file setup is done here; the two manual steps printed at the
# end finish the job.
#

XRAY_ETC=/usr/local/etc/xray
UI_DIR=${XRAY_ETC}/ui
CONFDIR=${XRAY_ETC}/conf.d
SUBDIR=${UI_DIR}/sub

mkdir -p "${UI_DIR}" "${SUBDIR}" "${CONFDIR}"
# world-readable: the stock rc script may run xray as an unprivileged user
chmod 755 "${XRAY_ETC}" "${UI_DIR}" "${SUBDIR}" "${CONFDIR}"

cat > /etc/rc.conf.d/xray <<EOF
# os-xray: use our confdir instead of the xray-core package default
xray_enable="YES"
xray_config="${CONFDIR}"
xray_env="XRAY_LOCATION_ASSET=${XRAY_ETC}"
EOF
chmod 644 /etc/rc.conf.d/xray

# make helper scripts executable
chmod +x /usr/local/opnsense/scripts/xray/*.py 2>/dev/null || true

# NOTE: geosite.dat/geoip.dat are intentionally NOT fetched here.
# Downloading from GitHub at install time can stall the install on slow
# networks; use the Xray -> Geosite page in the web UI to download them.

# flush the web UI menu cache by removing the file directly
# (no pluginctl call; pkg installs from a third-party repo don't trigger
# rc.configure_plugins, so we do it ourselves)
rm -f /var/lib/php/tmp/opnsense_menu_cache.xml 2>/dev/null || true

echo "os-nxova-xray installed. Two manual steps remain:"
echo "  1. service configd restart"
echo "  2. configctl webgui restart   (refreshes PHP so the new model loads)"
echo "Then open VPN -> Xray in the OPNsense web UI to configure."
exit 0
